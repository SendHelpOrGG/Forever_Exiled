<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ForeverExiled.App.Views.MetaView">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="14" Spacing="12">

            <!-- ============================= Headline ============================= -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="META OVERVIEW" Style="{StaticResource H1}" />
                    <Label Text="{Binding LeagueName, StringFormat='{0} · PoE 1 ladder · every tracked build'}"
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button Text="RESYNC"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="EXPORT CSV"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ExportReportCommand}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- ============================ Stat cards ============================ -->
            <FlexLayout Direction="Row" Wrap="Wrap" BindableLayout.ItemsSource="{Binding StatCards}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" WidthRequest="262" Margin="0,0,12,12" Padding="14">
                            <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                                <Grid WidthRequest="38" HeightRequest="38" VerticalOptions="Start">
                                    <Border BackgroundColor="{StaticResource SurfaceSunken}"
                                            Stroke="{StaticResource BorderSoft}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 11" />
                                    <Image Source="{Binding Image}"
                                           WidthRequest="24" HeightRequest="24"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding HasImage}" />
                                    <Label Text="{Binding Glyph}"
                                           Style="{StaticResource Glyph}"
                                           FontSize="16"
                                           TextColor="{Binding AccentColor}"
                                           IsVisible="{Binding HasImage, Converter={StaticResource InverseBool}}" />
                                </Grid>

                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="{Binding Caption}" Style="{StaticResource Micro}" FontSize="8.5" />
                                    <Label Text="{Binding Value}" Style="{StaticResource StatValue}" FontSize="22" />
                                    <Label Text="{Binding Hint}"
                                           Style="{StaticResource Caption}"
                                           FontSize="9.5"
                                           IsVisible="{Binding HasHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- ======================= Popular combinations ======================= -->
            <Border Style="{StaticResource Card}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="&#xE734;" Style="{StaticResource GlyphSmall}" TextColor="{StaticResource Accent}" FontSize="11" />
                            <Label Text="MOST POPULAR CLUSTER COMBINATIONS" Style="{StaticResource Micro}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding SampledBuildsText, StringFormat='across {0} sampled builds'}"
                               Style="{StaticResource Caption}" />
                    </Grid>

                    <BoxView Color="{StaticResource BorderSoft}" />

                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding TopCombos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource SurfaceSunken}"
                                        Stroke="{StaticResource BorderSoft}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,9"
                                        ToolTipProperties.Text="{Binding ItemTipText}">
                                    <Grid ColumnDefinitions="26,Auto,*,Auto" ColumnSpacing="10">
                                        <Label Text="{Binding RankText}"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="12"
                                               TextColor="{StaticResource TextFaint}"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center" />

                                        <Image Grid.Column="1"
                                               Source="{Binding SizeImage}"
                                               WidthRequest="26" HeightRequest="26"
                                               Aspect="AspectFit"
                                               VerticalOptions="Center" />

                                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Label}" Style="{StaticResource BodyStrong}" FontSize="12" />
                                            <Label Text="{Binding SkillsText}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="9.5"
                                                   IsVisible="{Binding ShowSkills}" />
                                            <Label Text="{Binding TopBuildText, StringFormat='top build · {0}'}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="9"
                                                   TextColor="{StaticResource TextFaint}"
                                                   IsVisible="{Binding HasTopBuild}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="3" Spacing="0" HorizontalOptions="End" VerticalOptions="Center">
                                            <Label Text="{Binding PercentText}"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="16"
                                                   TextColor="{StaticResource Accent}"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding BuildsText}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="9"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ======================== Leaders / notables ======================== -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="DPS LEADERS" Style="{StaticResource Micro}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="avg DPS" Style="{StaticResource Caption}" />
                        </Grid>
                        <BoxView Color="{StaticResource BorderSoft}" />

                        <VerticalStackLayout Spacing="11" BindableLayout.ItemsSource="{Binding MetaLeaders}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="20,*,Auto" RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="4" ColumnSpacing="8">
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding RankText}"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="12"
                                               TextColor="{StaticResource TextFaint}"
                                               VerticalOptions="Center" />

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Name}"
                                               Style="{StaticResource BodyStrong}"
                                               FontSize="11.5" />

                                        <Label Grid.Row="0" Grid.Column="2"
                                               Text="{Binding PrimaryText}"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="13.5"
                                               TextColor="{StaticResource Accent}"
                                               HorizontalTextAlignment="End" />

                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding SecondaryText}"
                                               Style="{StaticResource Caption}"
                                               FontSize="9.5" />

                                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HeightRequest="3">
                                            <Border BackgroundColor="{StaticResource SurfaceRaised}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 2" />
                                            <Border BackgroundColor="{Binding AccentColor}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 2"
                                                    HorizontalOptions="Start"
                                                    WidthRequest="{Binding BarPercent, Converter={StaticResource PercentWidth}, ConverterParameter=250}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="12">

                    <Border Style="{StaticResource Card}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="MOST USED NOTABLES" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="share of sample" Style="{StaticResource Caption}" />
                            </Grid>
                            <BoxView Color="{StaticResource BorderSoft}" />

                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding TopNotables}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="22,*,Auto" RowDefinitions="Auto,Auto"
                                              RowSpacing="3" ColumnSpacing="8">
                                            <Image Grid.Row="0" Grid.Column="0"
                                                   Source="{Binding Image}"
                                                   WidthRequest="18" HeightRequest="18"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource BodyStrong}"
                                                   FontSize="11" />
                                            <Label Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding PrimaryText}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="9.5"
                                                   TextColor="{StaticResource AccentDeep}" />
                                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HeightRequest="3">
                                                <Border BackgroundColor="{StaticResource SurfaceRaised}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 2" />
                                                <Border BackgroundColor="{Binding AccentColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 2"
                                                        HorizontalOptions="Start"
                                                        WidthRequest="{Binding BarPercent, Converter={StaticResource PercentWidth}, ConverterParameter=230}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="HIGHEST DPS BUILDS" Style="{StaticResource Micro}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="weighted" Style="{StaticResource Caption}" />
                            </Grid>
                            <BoxView Color="{StaticResource BorderSoft}" />

                            <VerticalStackLayout Spacing="7" BindableLayout.ItemsSource="{Binding TopBuilds}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="20,30,30,*,Auto" ColumnSpacing="7">
                                            <Label Text="{Binding RankText}"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="11"
                                                   TextColor="{StaticResource TextFaint}"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource GemTile}"
                                                    WidthRequest="30" HeightRequest="30"
                                                    Padding="2"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding HasGemImage}">
                                                <Image Source="{Binding GemImage}" Aspect="AspectFit" />
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource ClassTile}"
                                                    WidthRequest="30" HeightRequest="30"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding HasClassImage}">
                                                <Image Source="{Binding ClassImage}" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="3" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="11" />
                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="{Binding ClassText}" Style="{StaticResource Caption}" FontSize="9" VerticalOptions="Center" />
                                                    <Label Text="·" Style="{StaticResource Caption}" FontSize="9" VerticalOptions="Center" />
                                                    <Label Text="{Binding SkillText}" Style="{StaticResource Caption}" FontSize="9"
                                                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="4"
                                                   Text="{Binding DpsText}"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="12.5"
                                                   TextColor="{StaticResource Accent}"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Popularity comes from poe.ninja's ladder aggregate; cluster combinations come from each character's equipped jewels."
                   Style="{StaticResource Caption}"
                   FontSize="9.5"
                   Margin="2,0,0,8" />
        </VerticalStackLayout>
    </ScrollView>

</ContentView>
