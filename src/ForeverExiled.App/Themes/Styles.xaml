<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================ Typography ============================ -->

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="Micro" TargetType="Label">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="CharacterSpacing" Value="1.6" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="Label">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="Hero" TargetType="Label">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="StatValue" TargetType="Label">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="StatValueGold" TargetType="Label">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="TextColor" Value="{StaticResource Gold}" />
    </Style>

    <Style x:Key="Glyph" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="GlyphSmall" TargetType="Label" BasedOn="{StaticResource Glyph}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="GlyphGold" TargetType="Label" BasedOn="{StaticResource Glyph}">
        <Setter Property="TextColor" Value="{StaticResource Gold}" />
    </Style>

    <!-- ============================== Cards =============================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Stroke" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardFlush" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Stroke" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardSunken" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
        <Setter Property="Stroke" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Chips =============================== -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Stroke" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="7" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ChipGold" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource GoldTintBrush}" />
        <Setter Property="Stroke" Value="{StaticResource GoldDim}" />
    </Style>

    <!-- ========================= Selectable pills ========================= -->

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Stroke" Value="{StaticResource BorderSoftBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="9" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource GoldTintBrush}" />
                <Setter Property="Stroke" Value="{StaticResource GoldBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="FontAttributes" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillCount" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource GoldDeep}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Nav tiles ============================= -->

    <Style x:Key="NavTile" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0,9" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="11" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource GoldTintBrush}" />
                <Setter Property="Stroke" Value="{StaticResource GoldDim}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavCaption" TargetType="Label">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavGlyph" TargetType="Label" BasedOn="{StaticResource Glyph}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================= Skill row ============================ -->

    <Style x:Key="SkillRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="11" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource GoldTintBrush}" />
                <Setter Property="Stroke" Value="{StaticResource GoldDim}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Buttons ============================= -->

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinimumHeightRequest" Value="34" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#1A1409" />
        <Setter Property="BackgroundColor" Value="{StaticResource Gold}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinimumHeightRequest" Value="32" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="34" />
        <Setter Property="HeightRequest" Value="34" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextFaint}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="30" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource BorderSoft}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Gold}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
        <Setter Property="HeightRequest" Value="4" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Gold}" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

</ResourceDictionary>
